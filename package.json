{
  "name": "blink",
  "version": "0.1.0",
  "description": "Ambient blink reminder — subtle screen cues to prevent dry eyes. 100% local, no network.",
  "main": "./out/main/index.js",
  "author": "Blink",
  "license": "MIT",
  "private": true,
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "icon": "unset ELECTRON_RUN_AS_NODE; electron scripts/render-icon.cjs",
    "tray-icons": "unset ELECTRON_RUN_AS_NODE; electron scripts/render-tray-icons.cjs",
    "dev": "unset ELECTRON_RUN_AS_NODE; electron-vite dev",
    "build": "electron-vite build",
    "preview": "unset ELECTRON_RUN_AS_NODE; electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --mac",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@types/node": "^22.9.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
